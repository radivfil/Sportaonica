# ---------------------------------------------------------------
# FAZA A — DEMO  (Supabase Free + Cloudflare Workers Free)
# ISKLJUČIVO IZMIŠLJENI PODACI. Ova datoteka je predložak i smije
# se commitati: NIKAD ne upisujte tajne ovdje (provjera: npm run check:env).
#
# Ne-tajne vrijednosti su u wrangler.jsonc → "vars".
# Tajne (<…>) postavite naredbom:  npx wrangler secret put IME
# Za GitHub Actions: Settings → Secrets and variables → Actions.
# ---------------------------------------------------------------
APP_ENV=demo
NEXT_PUBLIC_APP_ENV=demo
NEXT_PUBLIC_SITE_URL=https://sportaonica.<subdomena>.workers.dev

# Supabase DEMO projekt (regija: EU Central / Frankfurt), plan Free
SUPABASE_URL=https://<demo-ref>.supabase.co
SUPABASE_ANON_KEY=<secret: anon / publishable key>
SUPABASE_SERVICE_ROLE_KEY=<secret: service_role / secret key — samo server>
SUPABASE_STORAGE_BUCKET=uploads

AUTH_SECRET=<secret: openssl rand -base64 32>
CRON_SECRET=<secret: openssl rand -base64 32>

# E-mail: bez RESEND_API_KEY e-mailovi idu u log (preporučeno za demo)
RESEND_API_KEY=
EMAIL_FROM="Sportaonica DEMO <onboarding@resend.dev>"
OWNER_NOTIFICATION_EMAIL=<e-mail za obavijesti>
EMAIL_DAILY_LIMIT=100
EMAIL_WARN_AT=70

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Backup (GitHub Actions secrets, ne Cloudflare)
SUPABASE_DB_URL=<secret: Session pooler connection string>
R2_ACCOUNT_ID=<cloudflare account id>
R2_BUCKET=sportaonica-backup-demo
R2_ACCESS_KEY_ID=<secret>
R2_SECRET_ACCESS_KEY=<secret>
AGE_PUBLIC_KEY=<age1… javni ključ za šifriranje>
HEARTBEAT_URL=<https://… heartbeat URL>
