# ---------------------------------------------------------------
# FAZA B — PRODUKCIJA  (Supabase PRO, regija EU, na račun klijenta)
# Prelazak A → B = samo ove vrijednosti + migracije. Kod se ne mijenja.
# Predložak: NIKAD ne upisujte tajne ovdje (npm run check:env).
#   npx wrangler secret put IME --env production
# ---------------------------------------------------------------
APP_ENV=production
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://sportaonica.hr

# Supabase PRODUKCIJSKI projekt (novi projekt, NE demo!), regija EU Central (Frankfurt)
SUPABASE_URL=https://<prod-ref>.supabase.co
SUPABASE_ANON_KEY=<secret>
SUPABASE_SERVICE_ROLE_KEY=<secret — samo server>
SUPABASE_STORAGE_BUCKET=uploads

AUTH_SECRET=<secret: novi, ne isti kao u demu>
CRON_SECRET=<secret: novi>

RESEND_API_KEY=<secret: domena sportaonica.hr potvrđena u Resendu>
EMAIL_FROM="Sportaonica <prijave@sportaonica.hr>"
OWNER_NOTIFICATION_EMAIL=<e-mail vlasnice>
EMAIL_DAILY_LIMIT=100
EMAIL_WARN_AT=70

NEXT_PUBLIC_TURNSTILE_SITE_KEY=<site key>
TURNSTILE_SECRET_KEY=<secret>

# Backup (GitHub Actions secrets, environment "production")
SUPABASE_DB_URL=<secret: Session pooler connection string>
R2_ACCOUNT_ID=<cloudflare account id>
R2_BUCKET=sportaonica-backup
R2_ACCESS_KEY_ID=<secret>
R2_SECRET_ACCESS_KEY=<secret>
AGE_PUBLIC_KEY=<age1… javni ključ; privatni ključ čuva vlasnica offline>
HEARTBEAT_URL=<https://… heartbeat URL>
