# ---------------------------------------------------------------
# Sportaonica — environment variables
# Copy to .env.local and fill in. Never commit real secrets.
# ---------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, OG, e-mail links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin (owner) login --------------------------------------
ADMIN_EMAIL=vlasnik@sportaonica.hr
ADMIN_PASSWORD=sportaonica-demo
# Long random string (openssl rand -base64 32). Signs the admin session cookie
# and cancellation tokens.
AUTH_SECRET=change-me-to-a-long-random-string

# --- Data layer ----------------------------------------------
# "json" (default demo store, file-based) or "supabase"
DATA_PROVIDER=json
# Where the JSON demo store lives (defaults to .data locally, /tmp on Vercel)
# DATA_DIR=.data

# Supabase (only when DATA_PROVIDER=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# --- E-mail --------------------------------------------------
# Without RESEND_API_KEY all e-mails are printed to the server console (demo mode).
RESEND_API_KEY=
EMAIL_FROM="Sportaonica <prijave@sportaonica.hr>"
# Where owner notifications go
OWNER_NOTIFICATION_EMAIL=sportaonica@gmail.com

# --- Anti-spam -----------------------------------------------
# Optional Cloudflare Turnstile. When both are set, forms require a valid token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Set to 1 to disable in-memory rate limiting (tests only)
RATE_LIMIT_DISABLED=
