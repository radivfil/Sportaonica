# ---------------------------------------------------------------
# Sportaonica — LOCAL development (copy to .env.local)
# Without SUPABASE_* the app uses a local JSON file (.data/db.json)
# with fictional data, and e-mails are printed to the console.
# ---------------------------------------------------------------
APP_ENV=local
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local admin login (refused unless APP_ENV=local). 2FA is required:
# add ADMIN_TOTP_SECRET to an authenticator app (README → "Lokalni admin").
ADMIN_EMAIL=vlasnica@sportaonica.test
ADMIN_PASSWORD=<lokalna-lozinka>
ADMIN_TOTP_SECRET=<base32-tajna npr. JBSWY3DPEHPK3PXP>
AUTH_SECRET=<min-32-znaka: openssl rand -base64 32>
CRON_SECRET=<min-32-znaka>

# Optional: point local dev at the DEMO Supabase project instead of JSON
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

RESEND_API_KEY=
EMAIL_FROM="Sportaonica <prijave@sportaonica.hr>"
OWNER_NOTIFICATION_EMAIL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 1 = disable rate limiting (tests only; ignored when APP_ENV=production)
RATE_LIMIT_DISABLED=
